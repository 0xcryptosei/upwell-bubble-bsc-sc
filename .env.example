# Upwell contracts: deploy settings. Copy to .env, fill in, then run:
#   npm run deploy:testnet      (BNB testnet, try this first)
#   npm run deploy:mainnet      (BNB Chain)
# .env is never committed. Keep it on this machine only, and never paste a private key anywhere else.

# Private key of the wallet that pays for the deployment (owner wallet). With or without 0x.
DEPLOYER_KEY=

# Owner wallet ADDRESS: admin of the contracts (settings, pause). A multisig is safer.
ADMIN=
# Owner wallet ADDRESS (or separate wallets): receives 10% (buyback & burn) and 5% (operations) at each weekly close
BUYBACK_WALLET=
OPS_WALLET=

# Operator wallet ADDRESS: a separate wallet whose key goes in backend/.env (OPERATOR_KEY). It closes the weeks.
OPERATOR=

# The owner wallet is also the deployer, so allow it as admin on mainnet. Remove when ADMIN is a multisig.
ALLOW_EOA_ADMIN=1
# Badges are not used by the app yet
DEPLOY_BADGES=0

# Optional: your own RPC (defaults to the public BNB Chain node)
BSC_RPC_URL=
BSC_TESTNET_RPC_URL=

# Phase 2 only (npm run deploy:staking:mainnet): the deployed RewardVault and the $UPW token
VAULT=
UPW_TOKEN=
